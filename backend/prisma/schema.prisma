// Prisma Schema for Happiwrapz E-Commerce (MongoDB Provider)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
}

enum AuthProvider {
  LOCAL
  GOOGLE
  PHONE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum CustomRequestStatus {
  PENDING
  CONTACTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model User {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  firstName      String
  lastName       String
  name           String
  email          String        @unique
  emailVerified  Boolean       @default(false)
  phone          String?
  phoneVerified  Boolean       @default(false)
  passwordHash   String?
  profileImage   String?
  role           Role          @default(CUSTOMER)
  authProvider   AuthProvider  @default(LOCAL)
  googleId       String?
  accountStatus  AccountStatus @default(ACTIVE)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  lastLoginAt    DateTime?

  sessions        Session[]
  loginActivities LoginActivity[]
  orders          Order[]
  cartItems       CartItem[]
  wishlistItems   WishlistItem[]
  reviews         Review[]
  customRequests  CustomRequest[]
  orderMessages   OrderMessage[]
}

model Session {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId    
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  ipAddress String?
  userAgent String?
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?
}

model LoginActivity {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId   
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress   String?
  userAgent   String?
  loginMethod String
  success     Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model Category {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  slug        String    @unique
  description String?
  image       String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products    Product[]
}

model Product {
  id                     String           @id @default(auto()) @map("_id") @db.ObjectId
  name                   String
  slug                   String           @unique
  description            String
  shortDescription       String?
  categoryId String @db.ObjectId           
  category               Category         @relation(fields: [categoryId], references: [id])
  price                  Float
  salePrice              Float?
  sku                    String           @unique
  image                  String
  images                 String[]         @default([])
  status                 String           @default("PUBLISHED")
  isFeatured             Boolean          @default(false)
  inStock                Boolean          @default(true)
  isActive               Boolean          @default(true)
  customizationAvailable Boolean          @default(false)
  colorOptionAvailable   Boolean          @default(false)
  advanceNoticeDays      Int              @default(1)
  advanceNoticeText      String?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  variants               ProductVariant[]
  cartItems              CartItem[]
  wishlistItems          WishlistItem[]
  orderItems             OrderItem[]
  reviews                Review[]
}

model ProductVariant {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  productId String @db.ObjectId   
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  price     Float
  stock     Int      @default(10)
  sku       String
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CartItem {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId   
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String @db.ObjectId   
  product             Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity            Int      @default(1)
  variant             String?
  customMessage       String?
  specialInstructions String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model WishlistItem {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId   
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String @db.ObjectId   
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Order {
  id                String         @id @default(auto()) @map("_id") @db.ObjectId
  orderNumber       String         @unique
  userId String @db.ObjectId         
  user              User           @relation(fields: [userId], references: [id])
  subtotal          Float
  deliveryCharge    Float          @default(0)
  discount          Float          @default(0)
  total             Float
  paymentStatus     PaymentStatus  @default(PENDING)
  orderStatus       OrderStatus    @default(PENDING)
  shippingAddress   String
  trackingCarrier   String?
  trackingNumber    String?
  estimatedDelivery DateTime?
  razorpayOrderId   String?
  razorpayPaymentId String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  items             OrderItem[]
  statusHistory     OrderStatusHistory[]
  messages          OrderMessage[]
}

model OrderItem {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  orderId String @db.ObjectId   
  order               Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String @db.ObjectId   
  product             Product  @relation(fields: [productId], references: [id])
  productName         String
  quantity            Int
  price               Float
  variant             String?
  customMessage       String?
  specialInstructions String?
}

model OrderStatusHistory {
  id        String      @id @default(auto()) @map("_id") @db.ObjectId
  orderId String @db.ObjectId      
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  updatedBy String      @default("SYSTEM")
  createdAt DateTime    @default(now())
}

model OrderMessage {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  orderId String @db.ObjectId   
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  senderId String @db.ObjectId   
  sender      User     @relation(fields: [senderId], references: [id])
  senderRole  Role
  message     String
  attachments String[] @default([])
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model CustomRequest {
  id              String              @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId?             
  user            User?               @relation(fields: [userId], references: [id])
  name            String
  phone           String
  email           String
  occasion        String
  budget          Float
  preferredColors String?
  customMessage   String?
  description     String
  referenceImage  String?
  adminNotes      String?
  status          CustomRequestStatus @default(PENDING)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
}

model Review {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId   
  user      User     @relation(fields: [userId], references: [id])
  productId String @db.ObjectId   
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderId String @db.ObjectId?  
  rating    Int
  comment   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
